generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  SCHOOL_VERIFIED
  VERIFIED
}

enum ListingStatus {
  PENDING
  APPROVED
  FLAGGED
  REJECTED
  REMOVED
}

enum ListingType {
  ENTIRE
  SHARED
  SUBLET
}

model User {
  id                 String            @id @default(cuid())
  email              String            @unique
  passwordHash       String?
  name               String
  avatarUrl          String?
  schoolId           String?
  phone              String?
  wechat             String?
  role               UserRole          @default(USER)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  school             School?           @relation(fields: [schoolId], references: [id])
  listings           Listing[]
  favorites          Favorite[]
  reports            Report[]
  contactRecords     ContactRecord[]   @relation("contact_by")
  adminReviews       AdminReview[]     @relation("reviewer")
  roommatePosts      RoommatePost[]
}

model School {
  id            String         @id @default(cuid())
  name          String
  city          String
  area          String
  listings      Listing[]
  users         User[]
  roommatePosts RoommatePost[]
}

model Listing {
  id              String          @id @default(cuid())
  title           String
  description     String
  city            String
  area            String
  address         String
  rent            Int
  distanceToSchool Float?
  deposit         Int
  moveInDate      DateTime
  availableUntil  DateTime?
  leaseMonths     Int
  bedrooms        Int
  bathrooms       Int
  furnishing      Boolean        @default(false)
  allowsPets      Boolean        @default(false)
  type            ListingType
  status          ListingStatus  @default(PENDING)
  contactMethod   String
  publisherId     String
  schoolId        String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  publisher       User           @relation(fields: [publisherId], references: [id])
  school          School         @relation(fields: [schoolId], references: [id])
  images          ListingImage[]
  favorites       Favorite[]
  reports         Report[]
  contactRecords  ContactRecord[]
  adminReviews    AdminReview[]
}

model ListingImage {
  id         String   @id @default(cuid())
  listingId  String
  url        String
  sortOrder  Int      @default(0)

  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model RoommatePost {
  id              String   @id @default(cuid())
  userId          String
  schoolId        String?
  title           String
  city            String
  area            String
  budget          Int
  moveInDate      DateTime
  genderPreference String?
  lifestyle       String?
  description     String
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id])
  school          School?  @relation(fields: [schoolId], references: [id])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  listingId  String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
}

model Report {
  id          String   @id @default(cuid())
  userId      String
  listingId   String
  reason      String
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model ContactRecord {
  id          String   @id @default(cuid())
  listingId   String
  userId      String
  message     String
  createdAt   DateTime @default(now())

  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user        User     @relation("contact_by", fields: [userId], references: [id], onDelete: Cascade)
}

model AdminReview {
  id          String   @id @default(cuid())
  listingId   String
  reviewerId  String
  status      ListingStatus
  note        String?
  createdAt   DateTime @default(now())

  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reviewer    User     @relation("reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
}
